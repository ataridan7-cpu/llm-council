# Required
OPENROUTER_API_KEY=sk-or-v1-...

# SEC EDGAR — required for 10-K/10-Q/8-K filings in research dossiers
# Must be: "AppName/Version ContactEmail" per SEC policy
SEC_USER_AGENT=StockCouncil/1.0 your@email.com

# Optional: Alpha Vantage free tier (25 req/day) as market-data fallback
ALPHA_VANTAGE_API_KEY=

# CORS origins — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend API base (for Vite builds pointing at a non-default backend)
VITE_API_BASE=http://localhost:8001

# Scheduler — set true to enable daily auto-evaluation + watchlist refresh
ENABLE_SCHEDULER=false

# Watchlist quick signal — set true to call a cheap LLM per ticker on refresh
WATCHLIST_QUICK_SIGNAL=false
